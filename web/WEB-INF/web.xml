<?xml version="1.0" encoding="UTF-8"?>
<web-app metadata-complete="false" version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee                              http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <display-name>AIStudyHub</display-name>
    <!-- metadata-complete="false" => Tomcat will read @WebServlet, @MultipartConfig annotations -->
    <servlet>
        <servlet-name>SystemConfigController</servlet-name>
        <servlet-class>Controller.SystemConfigController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SystemConfigController</servlet-name>
        <url-pattern>/admin/system-config</url-pattern>
    </servlet-mapping>

    <!-- Filter order is the order of these <filter-mapping> entries: SecurityHeadersFilter, RememberMeFilter, SessionSyncFilter, AuthFilter, then CsrfFilter.
         AuthFilter must also run on FORWARD because MainController forwards to the real controller;
         CsrfFilter only needs the original REQUEST. -->
    <filter>
        <filter-name>SecurityHeadersFilter</filter-name>
        <filter-class>Filter.SecurityHeadersFilter</filter-class>
    </filter>
    <filter>
        <filter-name>RememberMeFilter</filter-name>
        <filter-class>Filter.RememberMeFilter</filter-class>
    </filter>
    <filter>
        <filter-name>SessionSyncFilter</filter-name>
        <filter-class>Filter.SessionSyncFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>Filter.AuthFilter</filter-class>
    </filter>
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>Filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>
    <filter-mapping>
        <filter-name>RememberMeFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>
    <filter-mapping>
        <filter-name>SessionSyncFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- JSP fragments are included by UTF-8 pages; without this Jasper reads them as ISO-8859-1 and Vietnamese text is garbled. -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>

    <session-config>
        <!-- Session timeout: 30 minutes -->
        <session-timeout>30</session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
