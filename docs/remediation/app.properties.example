# AIStudyHub configuration (template)
#
# Copy to %USERPROFILE%\.aistudyhub\app.properties (or point AISTUDYHUB_CONFIG at another path)
# and fill in real values. NEVER commit the real file.
# Environment variables and JVM system properties with the same key override this file.
# Keys marked REQUIRED have no default: a missing one is logged at startup and the feature that needs it
# fails closed ("Missing required config: KEY"). Some keys below are only read by later tasks (T2.1, T3.x, T6.x).
# Read through Utils.AppConfig only (see docs/remediation/CONVENTIONS.md section 1).

# --- Database (REQUIRED) ---
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=ai_study_hub;encrypt=true;trustServerCertificate=true;
DB_USER=aistudyhub_app
DB_PASSWORD=

# --- Database pool (T6.1) ---
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=2

# --- Mail (REQUIRED for OTP / premium emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aistudyhub.noreply@gmail.com
SMTP_PASSWORD=

# --- Gemini (REQUIRED when AI_ENABLED=true) ---
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CONNECT_TIMEOUT_MS=5000
GEMINI_READ_TIMEOUT_MS=30000
GEMINI_MAX_HISTORY_MESSAGES=40

# --- Auth / sessions ---
# REQUIRED: long random string, e.g. 64 chars from a password manager
REMEMBER_ME_SECRET=
REMEMBER_ME_DAYS=30
# Set true when served over HTTPS (adds the Secure flag to cookies)
APP_HTTPS=false

# --- Rate limits (T3.5) ---
LOGIN_MAX_FAILURES_PER_MINUTE=5
OTP_SEND_MIN_INTERVAL_SECONDS=60
OTP_SEND_MAX_PER_HOUR=5
OTP_VALID_SECONDS=120
OTP_MAX_ATTEMPTS=3

# --- File storage (REQUIRED, T2.1) ---
# Absolute path, writable by the Tomcat user, OUTSIDE the web app folder (the app logs an error at startup otherwise).
# Files are stored as STORAGE_DIR/<userId>/<uuid>.<ext>. Back this folder up together with the database.
STORAGE_DIR=C:/aistudyhub-data/uploads

# --- Money (T4.4) ---
MAX_DEPOSIT=10000000

# --- Paging (T6.3) ---
PAGE_SIZE_DEFAULT=24
PAGE_SIZE_MAX=100

# --- Development only (T0.3). Leave false outside a local machine. ---
# When true the app creates user@gmail.com and admin@gmail.com at startup using DEV_SEED_PASSWORD.
DEV_SEED_TEST_USERS=false
DEV_SEED_PASSWORD=
